+def _qwen_get_image_features(self, pixel_values, image_grid_thw=None, **kwargs):
+    if not torch.is_grad_enabled() and getattr(self, "_cached_pv_ref", None) is pixel_values:
+        return getattr(self, "_cached_vis_feats")
+    parent = getattr(self, "_parent", None)
+    visual = getattr(parent, "visual", None) if parent is not None else (getattr(self, "_visual", None) or getattr(self, "visual", None))
+    pv_typed = pixel_values.type(visual.dtype)
+    image_embeds = visual(pv_typed, grid_thw=image_grid_thw, **kwargs)
+    if image_grid_thw is not None:
+        spatial_merge_size = getattr(visual, "spatial_merge_size", 2)
+        split_sizes = (image_grid_thw.prod(-1) // (spatial_merge_size**2)).tolist()
+        res = list(torch.split(image_embeds, split_sizes))
+    else:
+        res = [image_embeds]
+    if not torch.is_grad_enabled():
+        object.__setattr__(self, "_cached_pv_ref", pixel_values)
+        object.__setattr__(self, "_cached_vis_feats", res)
+    return res
+
+def _qwen_get_rope_index(self, *args, **kwargs):
+    parent = getattr(self, "_parent", None)
+    if parent is not None and hasattr(parent, "get_rope_index"):
+        return parent.get_rope_index(*args, **kwargs)
+    raise AttributeError("No parent Qwen model found for get_rope_index")
+
+def _get_rope_deltas(self):
+    return getattr(self, "_rope_deltas_val", None) or getattr(getattr(self, "_parent", self), "rope_deltas", None)
+
+def _set_rope_deltas(self, val):
+    object.__setattr__(self, "_rope_deltas_val", val)
+
+Qwen2_5_VLModel.get_image_features = _qwen_get_image_features
+Qwen2_5_VLModel.get_rope_index = _qwen_get_rope_index
+Qwen2_5_VLModel.language_model = property(lambda self: self)
+Qwen2_5_VLModel.rope_deltas = property(_get_rope_deltas, _set_rope_deltas)
 
